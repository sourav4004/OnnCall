# API Base URL for backend server integration
VITE_API_BASE_URL="http://localhost:5000/api/v1"

# Set to "true" to run with in-memory mock engine (zero backend required for prototyping & QA)
# Set to "false" to send live HTTP requests to VITE_API_BASE_URL
VITE_USE_MOCK_API="true"

# App Public URL
VITE_APP_URL="http://localhost:3000"

# Optional: Mapbox / Google Maps API Key for technician live GPS tracking
VITE_MAPS_API_KEY=""
